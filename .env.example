# AI API Keys (user-provided)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# Database (AWS only - GCP/Azure use defaults from Terraform)
DB_USERNAME=cointelligence

# AWS Credentials (for Bedrock or AWS deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Auto-populated by deploy scripts - leave empty
DATABASE_URL=
SECRET_KEY=
S3_BUCKET_NAME=
GCS_BUCKET=
AZURE_STORAGE_ACCOUNT=
CODE_EXECUTOR_URL=
