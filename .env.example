# Database Configuration (DB_PASSWORD is in AWS Secrets Manager)
DB_USERNAME=cointelligence

# Application Secrets (SECRET_KEY is auto-generated in AWS Secrets Manager)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI API Keys (user-provided)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=your-groq-api-key-here

# Get your Tavily API key from https://tavily.com/ for web search functionality
TAVILY_API_KEY=your-tavily-api-key-here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Frontend Configuration (auto-updated by deploy.sh)
NEXT_PUBLIC_API_URL=http://localhost:8000
