# ============================================
# Co-Intelligence Environment Configuration
# ============================================
# Copy this file to .env and update values
# Deploy scripts auto-populate infrastructure values
# ============================================

# ============================================
# YOU MUST SET THESE (all platforms)
# ============================================
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# ============================================
# AWS DEPLOYMENT (set before running deploy.sh)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Auto-populated by deploy.sh:
# - DATABASE_URL (from RDS + Secrets Manager)
# - SECRET_KEY (from Secrets Manager)
# - S3_BUCKET_NAME (from CloudFormation)
# - CODE_EXECUTOR_URL (Lambda ARN)

# ============================================
# GCP DEPLOYMENT (set before running deploy-gcp.sh)
# ============================================
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# Auto-populated by deploy-gcp.sh:
# - DATABASE_URL (from Cloud SQL + Terraform)
# - SECRET_KEY (from Terraform)
# - GCS_BUCKET (from Terraform)
# - CODE_EXECUTOR_URL (Cloud Function URL)

# ============================================
# AZURE DEPLOYMENT (set before running deploy-azure.sh)
# ============================================
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_LOCATION=eastus

# Auto-populated by deploy-azure.sh:
# - DATABASE_URL (from Azure PostgreSQL + Terraform)
# - SECRET_KEY (from Terraform)
# - AZURE_STORAGE_ACCOUNT (from Terraform)
# - CODE_EXECUTOR_URL (Azure Function URL)

# ============================================
# LOCAL DEVELOPMENT (manual setup)
# ============================================
DATABASE_URL=postgres://user:password@localhost:5432/cointelligence?sslmode=require
SECRET_KEY=your-secret-key-min-32-chars
S3_BUCKET_NAME=
CODE_EXECUTOR_URL=

# ============================================
# OPTIONAL - Defaults shown (uncomment to change)
# ============================================
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_PER_SECOND=20
# MAX_FILE_SIZE=104857600
# CORS_ALLOW_ORIGINS=http://localhost:3000
# COOKIE_ACCESS_NAME=access_token
# COOKIE_REFRESH_NAME=refresh_token
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# COOKIE_PATH=/
