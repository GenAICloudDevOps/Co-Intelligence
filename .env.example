# ============================================
# Co-Intelligence Environment Configuration
# ============================================
# Copy this file to .env and update values
# Deploy scripts auto-populate infrastructure values
# ============================================

# ============================================
# YOU MUST SET THESE (all platforms)
# ============================================
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key
TINKER_API_KEY=your-tinker-api-key
TINKER_BASE_PATH=/app

# Cloud provider: aws | gcp | azure
CLOUD_PROVIDER=aws

# ============================================
# AWS DEPLOYMENT (set before running deploy-aws.sh)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Auto-populated by deploy-aws.sh:
# - DATABASE_URL (from RDS + Secrets Manager)
# - SECRET_KEY (from Secrets Manager)
# - S3_BUCKET_NAME (from CloudFormation)
# - CODE_EXECUTOR_URL (Lambda ARN)
# - REDIS_URL (ElastiCache endpoint)

# ============================================
# GCP DEPLOYMENT (set before running deploy-gcp.sh)
# ============================================
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# GCP Data Analysis (App 8)
# GCP_WORKFLOWS_LOCATION=us-central1
# GCP_WORKFLOWS_NAME=data-analysis-pipeline
# GCP_BIGQUERY_DATASET=co_intelligence_data_analysis
# GCP_STORAGE_BUCKET=your-gcs-bucket

# Auto-populated by deploy-gcp.sh:
# - DATABASE_URL (from Cloud SQL + Terraform)
# - SECRET_KEY (from Terraform)
# - GCS_BUCKET (from Terraform)
# - CODE_EXECUTOR_URL (Cloud Function URL)

# ============================================
# AZURE DEPLOYMENT (set before running deploy-azure.sh)
# ============================================
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_LOCATION=eastus

# Azure Data Analysis (App 8)
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=data-analysis
# AZURE_LOGIC_APP_TRIGGER_URL=https://your-logic-app.azurewebsites.net/...
# AZURE_SYNAPSE_SQL_ENDPOINT=your-synapse.sql.azuresynapse.net
# AZURE_SYNAPSE_DATABASE=co_intelligence

# Auto-populated by deploy-azure.sh:
# - DATABASE_URL (from Azure PostgreSQL + Terraform)
# - SECRET_KEY (from Terraform)
# - AZURE_STORAGE_ACCOUNT (from Terraform)
# - CODE_EXECUTOR_URL (Azure Function URL)

# ============================================
# LOCAL DEVELOPMENT (manual setup)
# ============================================
DATABASE_URL=postgres://user:password@localhost:5432/cointelligence?sslmode=require
SECRET_KEY=your-secret-key-min-32-chars
S3_BUCKET_NAME=
CODE_EXECUTOR_URL=
DATA_ANALYSIS_STATE_MACHINE_ARN=
DATA_ANALYSIS_GLUE_DATABASE=co_intelligence_data_analysis
DATA_ANALYSIS_ATHENA_WORKGROUP=co-intelligence-data-analysis
DATA_ANALYSIS_ATHENA_OUTPUT_S3_URI=
REDIS_URL=rediss://your-redis-endpoint:6379/0

# ============================================
# OPTIONAL - Defaults shown (uncomment to change)
# ============================================
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_PER_SECOND=20
# MAX_FILE_SIZE=104857600
# CORS_ALLOW_ORIGINS=http://localhost:3000
# ENABLE_OBSERVABILITY=false
# FRONTEND_URL=https://app.example.com
# Required for password reset links; avoid localhost/127.0.0.1 in production.
# COOKIE_ACCESS_NAME=access_token
# COOKIE_REFRESH_NAME=refresh_token
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# COOKIE_PATH=/
# Terminal (App 9) - defaults
# TERMINAL_IMAGE=ubuntu:22.04
# TERMINAL_CPU=1
# TERMINAL_MEMORY=1g
# TERMINAL_PIDS_LIMIT=256
# TERMINAL_IDLE_TIMEOUT_SECONDS=900
# TERMINAL_BLOCK_PRIVATE_NETS=true

# Email notifications (Gmail SMTP) - optional
# GMAIL_SMTP_USER=your-sender@gmail.com
# GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
# GMAIL_SMTP_FROM_NAME=Co-Intelligence

# Slack Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
