# GCP Configuration Template
# Copy this to .env.gcp and fill in your values

# GCP Settings (auto-filled by deploy-gcp.sh from Terraform)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-east1

# Database (auto-filled by deploy-gcp.sh from Terraform)
DATABASE_URL=postgres://cointelligence:PASSWORD@DB_HOST:5432/cointelligence

# Storage (auto-filled by deploy-gcp.sh from Terraform)
GCS_BUCKET=your-bucket-name

# App Secret (auto-filled by deploy-gcp.sh from Terraform)
SECRET_KEY=your-secret-key

# AI API Keys (USER PROVIDED - required for AI features)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# AWS Credentials (for Bedrock AI - optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
